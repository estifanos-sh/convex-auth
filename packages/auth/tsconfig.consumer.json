{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@convex/*": ["../../convex/*"],
      "@estifanos-sh/convex-auth/permissions": ["./src/permissions/index"],
      "@estifanos-sh/convex-auth/browser": ["./src/browser/index"],
      "@estifanos-sh/convex-auth/client": ["./src/client/index"],
      "@estifanos-sh/convex-auth/react": ["./src/react/index"],
      "@estifanos-sh/convex-auth/svelte": ["./src/svelte/index"],
      "@estifanos-sh/convex-auth/component": ["./src/component/index"],
      "@estifanos-sh/convex-auth/core": ["./src/core/index"],
      "@estifanos-sh/convex-auth/convex.config": ["./src/component/convex.config"],
      "@estifanos-sh/convex-auth/expo": ["./src/expo/index"],
      "@estifanos-sh/convex-auth/server": ["./src/server/index"],
      "@estifanos-sh/convex-auth/providers": ["./src/providers/index"],
      "@estifanos-sh/convex-auth/providers/*": ["./src/providers/*"]
    }
  },
  "include": ["consumer/**/*.ts"]
}
