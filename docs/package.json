{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "generate:content": "node ./scripts/content/compile.ts && vp fmt src/generated",
    "build": "pnpm run generate:content && vp build && vp fmt src/routeTree.gen.ts && node ./scripts/static/assemble.ts && pnpx pagefind --site dist/client/convex-auth",
    "preview": "vp preview",
    "check": "pnpm run generate:content && node ./scripts/content/truth.ts && vp exec tsc --noEmit --project ./tsconfig.json"
  },
  "dependencies": {
    "@tanstack/solid-router": "^1.170.22",
    "@tanstack/solid-start": "^1.168.39",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "pagefind": "^1.3.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.0.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.14"
  }
}
